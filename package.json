	"bugs": {
		"url": "https://github.com/noltron000/rotten-potatoes/issues"
	},
	"homepage": "https://github.com/noltron000/rotten-potatoes#readme",
	"dependencies": {
		"dotenv": "^18.0.9",
		"express": "^4.22.3",
		"express-handlebars": "^8.0.1",
		"method-override": "^3.0.0",
		"mongoose": "^9.11.4",
		"moviedb-promise": "^4.0.8"
	},
	"devDependencies": {
		"concurrently": "^10.0.6",
		"cross-env": "^10.1.0",
		"nodemon": "^3.1.14",
		"sass": "^1.107.1"
	},
