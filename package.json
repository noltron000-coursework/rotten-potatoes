{
	"name": "rotten-potatoes",
	"version": "1.1.0",
	"description": "Backend Web Project",
	"main": "source/app.mjs",
	"type": "module",
	"scripts": {
		"start": "sass public/scss:public/css && node source/app.mjs",
		"dev": "cross-env NODE_ENV=development concurrently --kill-others \"sass --watch public/scss:public/css\" \"nodemon --watch source --watch views source/app.mjs\"",
		"test": "node --test test/api-classes.test.mjs"
	},
	"repository": {
