<!--
	Main HBS Rendering Template
	views/layouts/main.hbs
-->

<!doctype html>
<html>
	<head>
		<meta charset='utf-8'>
		<meta name='viewport' content='width=device-width, initial-scale=1'>
		<title>{{#if title}}{{title}} | {{/if}}Rotten Potatoes</title>
		<link
			rel='stylesheet'
			href='/css/reset.css'
		/>
		<link
			rel='stylesheet'
			href='/css/styles.css'
		/>
	</head>

	<body>
		<header class='site-header'>
			<a class='site-brand' href='/'>Rotten Potatoes</a>
			<nav aria-label='Main navigation'>
				<a href='/'>Home</a>
				<a href='/movies?sortBy=now-playing'>Now Playing</a>
				<a href='/movies?sortBy=popular'>Popular</a>
				<a href='/movies?sortBy=top-rated'>Top Rated</a>
				<a href='/movies?sortBy=upcoming'>Upcoming</a>
			</nav>
		</header>

		<div class='page-shell'>
			{{!-- This contains all other page information. --}}
			{{{body}}}
		</div>

		{{#if devMode}}
		<script>
			const developmentEvents = new EventSource('/__dev/reload')
			developmentEvents.onmessage = () => window.location.reload()
		</script>
		{{/if}}
	</body>
</html>
