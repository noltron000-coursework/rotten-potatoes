<!--
	Movie Card
	views/partials/movie-card.hbs
--->

<!--
	Variables:
	- movie (a parsed movie object)
--->

<article class='movie' data-movie-id='{{movie.ids.api}}' data-movie-type='{{type}}'>

	{{#if (equals type 'page')}}
	<div class='movie-media-column'>
	{{/if}}

	<!-- Main Poster --->
	<a
		class='movie-poster'
		href='{{join '/movies/' movie.ids.api}}'
		aria-label="View {{movie.title}} movie page"
	>
		<figure class='movie-poster-picture'>
			<picture>
				<img src='{{movie.posters.[0].sizes.[3].urls.main}}' alt='Poster for {{movie.title}}' />
			</picture>
			<figcaption class='movie-title {{#if (equals type 'card')}}movie-card-caption{{else}}movie-page-caption{{/if}}'>
				{{#if (equals type 'page')}}
				<h1>{{movie.title}}</h1>
				{{else}}
				<h2>{{movie.title}}</h2>
				{{/if}}
				{{#if movie.originalTitle}}
				<p>{{movie.originalTitle}}</p>
				{{/if}}
			</figcaption>
		</figure>
	</a>

	<!-- Main Trailer --->
	<div class='movie-trailer' id='trailer-{{movie.ids.api}}' {{#if (equals type 'card')}}hidden{{/if}}>
		<iframe
			src='{{movie.videos.[0].urls.embed}}'
			title='YouTube video player'
			allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
			allowfullscreen='true'
		></iframe>
	</div>

	{{#if (equals type 'page')}}
	<section class='movie-ratings-card'>
		<h3 class='movie-section-heading'>Ratings</h3>
		<table class='movie-ratings'>
			<tbody>
				{{#repeat 5 0}}
				<tr>
					<th scope='row'>{{@index}}</th>
					<td><meter
						min=0
						max={{movie.ratings.histogramCount}}
						optimum={{movie.ratings.histogramCount}}
						value={{movie.ratings.histogram.[@index].count}}
					>{{movie.ratings.histogram.[@index].count}}</meter></td>
					<td>{{movie.ratings.histogram.[@index].percent}}%</td>
				</tr>
				{{/repeat}}
			</tbody>
		</table>
	</section>

	<div class='movie-actions'>
	<a class='action-link' href='{{movie.posters.[0].sizes.[0].urls.main}}'>View Full-Size Poster</a>
	<a class='action-link' href='{{join '/reviews/new?movieId=' movie.ids.api}}'>Write a Review</a>
	</div>
	</div>
	{{/if}}

	<!-- Details Section --->
	<section class='movie-details' id='details-{{movie.ids.api}}' {{#if (equals type 'card')}}hidden{{/if}}>
		<h3 class='movie-section-heading'>Movie Details</h3>

		<!-- Facts --->
		<dl class='movie-facts'>
			<div>
				<dt>Viewer Polls</dt>
				<dd><meter
					min=0
					max=5
					optimum=5
					value={{movie.ratings.average}}
					data-rating={{movie.ratings.average}}
				>{{movie.ratings.vulgarAverage}}</meter></dd>
				<dd><span>{{movie.ratings.vulgarAverage}}</span> stars</dd>
			</div>

			<div>
				<dt>Poll Count</dt>
				<dd>{{movie.ratings.count}} votes</dd>
			</div>

			<div>
				<dt>Review Count</dt>
				<dd>{{movie.reviewCount}} reviews</dd>
			</div>
			<div>
				<dt>Tagline</dt>
				<dd>{{movie.tagline}}</dd>
			</div>
			<div>
				<dt>Rating</dt>
				<dd>{{movie.certification}}</dd>
			</div>
			<div>
				<dt>Runtime</dt>
				<dd>
					{{#with movie.runtime}}
					{{#if hours}}{{hours}}hr{{/if}}
					{{#if minutes}}{{minutes}}min{{/if}}
					{{#if seconds}}{{seconds}}sec{{/if}}
					{{/with}}
				</dd>
			</div>
			<div>
				<dt>Release Date</dt>
				<dd>
					{{#with movie.releases.[0].date}}
					{{#if day}}{{day}}{{/if}}
					{{#if month}}{{month}}{{/if}}
					{{#if year}}{{year}}{{/if}}
					{{/with}}
				</dd>
			</div>
			<div>
				<dt>Genres</dt>
				{{#each movie.genres as |genre|}}
				<dd>{{genre.name}}</dd>
				{{/each}}
			</div>
		</dl>

		<!-- Overview --->
		<dl class='movie-overview'>
			<div>
				<dt>Overview</dt>
				<dd><p>{{movie.overview}}</p></dd>
			</div>
		</dl>

		{{!-- 🗂️ THIS DIFFERENTIATES A PAGE FROM A CARD --}}
		{{#if (equals type 'page')}}

		<!-- Trivia --->
		<dl></dl>

		<!-- List Media --->
		<section class='media-galleries'>
			<header class='media-galleries-header'>
				<h3 class='movie-section-heading'>Media</h3>
			</header>

			<section class='media-gallery' data-media-gallery>
				<header>
					<h4>Posters</h4>
					<p class='media-count'>{{movie.posters.length}} items</p>
				</header>
				<ul class='media-gallery-grid poster-gallery-grid' data-media-items>
					{{#each movie.posters as |poster|}}
					<li data-media-item>
						<a href='{{poster.sizes.[0].urls.main}}' aria-label='Load full-size poster image'>
							<img src='{{poster.sizes.[3].urls.main}}' alt='Poster for {{../movie.title}}' loading='lazy' />
						</a>
					</li>
					{{else}}
					<li class='media-empty'>No posters available.</li>
					{{/each}}
				</ul>
				<nav class='media-pagination' aria-label='Poster pagination'>
					<button type='button' data-media-prev aria-label='Previous posters'>Previous</button>
					<p><span data-media-current>1</span> / <span data-media-total>1</span></p>
					<button type='button' data-media-next aria-label='Next posters'>Next</button>
				</nav>
			</section>

			<section class='media-gallery' data-media-gallery>
				<header>
					<h4>Backdrops</h4>
					<p class='media-count'>{{movie.backdrops.length}} items</p>
				</header>
				<ul class='media-gallery-grid backdrop-gallery-grid' data-media-items>
					{{#each movie.backdrops as |backdrop|}}
					<li data-media-item>
						<a href='{{backdrop.sizes.[0].urls.main}}' aria-label='Load full-size backdrop image'>
							<img src='{{backdrop.sizes.[3].urls.main}}' alt='Backdrop from {{../movie.title}}' loading='lazy' />
						</a>
					</li>
					{{else}}
					<li class='media-empty'>No backdrops available.</li>
					{{/each}}
				</ul>
				<nav class='media-pagination' aria-label='Backdrop pagination'>
					<button type='button' data-media-prev aria-label='Previous backdrops'>Previous</button>
					<p><span data-media-current>1</span> / <span data-media-total>1</span></p>
					<button type='button' data-media-next aria-label='Next backdrops'>Next</button>
				</nav>
			</section>

			<section class='media-gallery' data-media-gallery>
				<header>
					<h4>Videos</h4>
					<p class='media-count'>{{movie.videos.length}} items</p>
				</header>
				<ul class='media-gallery-grid video-gallery-grid' data-media-items>
					{{#each movie.videos as |video|}}
					<li data-media-item>
						<a href='{{video.urls.main}}' aria-label='Watch {{video.name}}'>
							<img class='video-preview-blur' src='{{video.thumbnail.sizes.[0].urls.main}}' alt='' aria-hidden='true' />
							<img class='video-preview-image' src='{{video.thumbnail.sizes.[0].urls.main}}' alt='{{video.name}} thumbnail' loading='lazy' />
							<span>{{video.name}}</span>
						</a>
					</li>
					{{else}}
					<li class='media-empty'>No videos available.</li>
					{{/each}}
				</ul>
				<nav class='media-pagination' aria-label='Video pagination'>
					<button type='button' data-media-prev aria-label='Previous videos'>Previous</button>
					<p><span data-media-current>1</span> / <span data-media-total>1</span></p>
					<button type='button' data-media-next aria-label='Next videos'>Next</button>
				</nav>
			</section>
		</section>

		{{/if}}

	</section><!-- End Details Section --->

	{{#if (equals type 'page')}}
	<div class='movie-reviews-column'>
		<section id='reviews-index'>
			<h3 class='movie-section-heading'>Reviews</h3>
			{{> reviews-list reviews=movie.reviews}}
		</section>

		<nav id='review-pagination'>
			<dl>
				<div>
					<dt>Review Pages</dt>
					<dd>
						<button
							data-index=0
						>db</button>
					</dd>
					{{#unless (equals 0 reviewPagination.totalPages)}}
					{{#repeat 1 reviewPagination.totalPages}}
					<dd>
						<button
							data-index={{@index}}
						>{{@index}}</button>
					</dd>
					{{/repeat}}
					{{/unless}}
				</div>
			</dl>
		</nav>
	</div>
	{{/if}}

	{{#if (equals type 'card')}}
	<div class='movie-actions'>
		<button
			type='button'
			data-load-movie-details
			aria-controls='details-{{movie.ids.api}} trailer-{{movie.ids.api}}'
			aria-expanded='false'
		>Load Movie Details</button>
		<a class='action-link' href='{{join '/movies/' movie.ids.api}}'>View Movie Page</a>
	<a class='action-link' href='{{movie.posters.[0].sizes.[0].urls.main}}'>View Full-Size Poster</a>
	<a class='action-link' href='{{join '/reviews/new?movieId=' movie.ids.api}}'>Write a Review</a>
	</div>
	{{/if}}

</article><!-- End Movie Article --->
